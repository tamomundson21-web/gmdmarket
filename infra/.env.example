# Kopyala: cp .env.example .env
# DB_PASSWORD mutlaka değiştir - sır, repo/loga girmez.

DB_PASSWORD=degistir-buraya

# API
API_PORT=3001
API_HOST=0.0.0.0
NODE_ENV=development

# Veritabanı (host'a bağlanırken localhost)
DATABASE_URL=postgresql://gmd:${DB_PASSWORD}@localhost:5432/gmd
REDIS_URL=redis://localhost:6379